<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TREZZY 3D | Admin Control</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-zinc-950 text-zinc-100 font-sans">

  <!-- LOGIN ADMIN -->
  <div id="admin-login" class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-zinc-900 border border-zinc-800 rounded-2xl p-7 shadow-2xl">
      <h1 class="text-2xl font-black text-rose-600 text-center">TREZZY ADMIN</h1>
      <p class="text-xs text-zinc-400 text-center mt-1 mb-6">Acesso Restrito ao Proprietário</p>
      <form id="form-admin-login" class="space-y-4">
        <input
          id="admin-pass-input"
          type="password"
          required
          placeholder="Senha Administrativa"
          class="w-full bg-zinc-950 border border-zinc-800 focus:border-rose-600 focus:outline-none text-sm px-4 py-3 rounded-xl"
        />
        <button type="submit" class="w-full bg-rose-600 hover:bg-rose-500 text-white font-bold text-sm py-3 rounded-xl cursor-pointer">
          Entrar no Painel Admin
        </button>
      </form>
      <p id="admin-err" class="text-xs text-red-400 text-center mt-3 hidden"></p>
    </div>
  </div>

  <!-- PAINEL ADMIN -->
  <div id="admin-panel" class="hidden max-w-6xl mx-auto p-4 md:p-8 space-y-6">
    <header class="flex items-center justify-between border-b border-zinc-800 pb-4">
      <div>
        <span class="text-xl font-black text-rose-600">TREZZY 3D • ADMIN</span>
        <p class="text-xs text-zinc-400">Banco de Dados Conectado: Supabase</p>
      </div>
      <div class="flex gap-2">
        <a href="/dashboard.html" class="bg-zinc-800 hover:bg-zinc-700 text-xs font-bold px-3.5 py-2 rounded-xl">Ver como Cliente</a>
        <button onclick="adminLogout()" class="bg-red-950 text-red-300 text-xs font-bold px-3.5 py-2 rounded-xl cursor-pointer">Sair</button>
      </div>
    </header>

    <!-- Métricas -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
        <span class="text-xs text-zinc-400">Total de Chaves Emitidas</span>
        <p id="kpi-total" class="text-3xl font-black text-white mt-1">0</p>
      </div>
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
        <span class="text-xs text-zinc-400">Chaves VIP Ativas</span>
        <p id="kpi-vip" class="text-3xl font-black text-amber-400 mt-1">0</p>
      </div>
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-5">
        <span class="text-xs text-zinc-400">Total de Downloads Realizados</span>
        <p id="kpi-dl" class="text-3xl font-black text-emerald-400 mt-1">0</p>
      </div>
    </div>

    <!-- Gerar Nova Chave -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
      <h2 class="text-base font-bold text-white mb-4">Gerar Nova Chave de Cliente</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <input id="cli-nome" type="text" placeholder="Nome / WhatsApp do Cliente" class="bg-zinc-950 border border-zinc-800 text-sm px-4 py-2.5 rounded-xl" />
        <select id="cli-plano" class="bg-zinc-950 border border-zinc-800 text-sm px-4 py-2.5 rounded-xl">
          <option value="teste">🧪 Teste — 10 Downloads</option>
          <option value="premium">⭐ Premium — 50 Downloads</option>
          <option value="vip">👑 VIP — ALL Downloads + Updates</option>
        </select>
        <button onclick="criarChave()" class="bg-rose-600 hover:bg-rose-500 text-white font-bold text-sm py-2.5 rounded-xl cursor-pointer">
          + Gerar & Copiar Chave
        </button>
      </div>
    </div>

    <!-- Tabela de Clientes -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
      <div class="p-5 border-b border-zinc-800 flex justify-between items-center">
        <h3 class="text-sm font-bold">Clientes Cadastrados no Supabase</h3>
        <button onclick="carregarChaves()" class="text-xs text-zinc-400 hover:text-white cursor-pointer">Atualizar</button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-950 text-zinc-400 uppercase">
            <tr>
              <th class="px-4 py-3">Chave</th>
              <th class="px-4 py-3">Cliente</th>
              <th class="px-4 py-3">Plano</th>
              <th class="px-4 py-3">Consumo</th>
              <th class="px-4 py-3 text-right">Ações</th>
            </tr>
          </thead>
          <tbody id="lista-chaves" class="divide-y divide-zinc-800"></tbody>
        </table>
      </div>
    </div>

    <!-- Alterar Senha Admin -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 max-w-md space-y-3">
      <h3 class="text-sm font-bold">Alterar Senha Mestra</h3>
      <input id="nova-senha-admin" type="password" placeholder="Nova senha (mín. 4 dígitos)" class="w-full bg-zinc-950 border border-zinc-800 text-sm px-4 py-2.5 rounded-xl" />
      <button onclick="trocarSenha()" class="bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl cursor-pointer">
        Salvar Nova Senha
      </button>
    </div>
  </div>

  <script>
    let adminToken = localStorage.getItem('trezzy_admin_token') || '';

    document.getElementById('form-admin-login').addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = document.getElementById('admin-pass-input').value.trim();
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password, scope: 'admin' }),
      });
      const data = await res.json();
      if (!res.ok) {
        const err = document.getElementById('admin-err');
        err.textContent = data.error || 'Acesso negado.';
        err.classList.remove('hidden');
        return;
      }
      adminToken = data.token;
      localStorage.setItem('trezzy_admin_token', adminToken);
      iniciarAdmin();
    });

    function adminLogout() {
      localStorage.removeItem('trezzy_admin_token');
      adminToken = '';
      document.getElementById('admin-panel').classList.add('hidden');
      document.getElementById('admin-login').classList.remove('hidden');
    }

    async function carregarChaves() {
      const res = await fetch('/api/admin/tokens', {
        headers: { Authorization: `Bearer ${adminToken}` },
      });
      if (!res.ok) {
        adminLogout();
        return;
      }
      const { tokens } = await res.json();
      document.getElementById('kpi-total').textContent = tokens.length;
      document.getElementById('kpi-vip').textContent = tokens.filter((t) => t.plan === 'vip').length;
      document.getElementById('kpi-dl').textContent = tokens.reduce((a, b) => a + (b.downloads_used || 0), 0);

      const tbody = document.getElementById('lista-chaves');
      tbody.innerHTML = '';
      tokens.forEach((t) => {
        const uso = t.max_downloads === null ? `${t.downloads_used} (VIP)` : `${t.downloads_used} / ${t.max_downloads}`;
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="px-4 py-3 font-mono font-bold text-white">${t.code}</td>
          <td class="px-4 py-3 text-zinc-300">${t.label}</td>
          <td class="px-4 py-3 text-zinc-300">${t.plan_name}</td>
          <td class="px-4 py-3 text-emerald-400 font-semibold">${uso}</td>
          <td class="px-4 py-3 text-right space-x-2">
            <button onclick="navigator.clipboard.writeText('${t.code}'); alert('Chave copiada: ${t.code}')" class="bg-zinc-800 px-2.5 py-1 rounded cursor-pointer">Copiar</button>
            <button onclick="removerChave('${t.code}')" class="bg-red-950 text-red-300 px-2.5 py-1 rounded cursor-pointer">Excluir</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    async function criarChave() {
      const label = document.getElementById('cli-nome').value.trim() || 'Cliente';
      const plan = document.getElementById('cli-plano').value;
      const res = await fetch('/api/admin/tokens', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${adminToken}` },
        body: JSON.stringify({ label, plan }),
      });
      const data = await res.json();
      if (res.ok && data.token) {
        navigator.clipboard.writeText(data.token.code);
        alert(`Chave criada e copiada: ${data.token.code}`);
        document.getElementById('cli-nome').value = '';
        carregarChaves();
      }
    }

    async function removerChave(code) {
      await fetch(`/api/admin/tokens?code=${encodeURIComponent(code)}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${adminToken}` },
      });
      carregarChaves();
    }

    async function trocarSenha() {
      const newPassword = document.getElementById('nova-senha-admin').value.trim();
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${adminToken}` },
        body: JSON.stringify({ newPassword }),
      });
      const data = await res.json();
      if (res.ok) {
        adminToken = data.token;
        localStorage.setItem('trezzy_admin_token', adminToken);
        alert('Senha alterada com sucesso!');
      }
    }

    function iniciarAdmin() {
      document.getElementById('admin-login').classList.add('hidden');
      document.getElementById('admin-panel').classList.remove('hidden');
      carregarChaves();
    }

    if (adminToken) iniciarAdmin();
  </script>
</body>
</html>
